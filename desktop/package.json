{
  "name": "healthcare-os-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Healthcare OS — Desktop Application",
  "author": "Healthcare OS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.healthcare-os.desktop",
    "productName": "Healthcare OS",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "database.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": [
          "package.json",
          "next.config.js",
          ".next/**/*",
          "public/**/*",
          "node_modules/next/**/*",
          "node_modules/react/**/*",
          "node_modules/react-dom/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "publisherName": "Healthcare OS"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Healthcare OS",
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Medical"
    }
  },
  "devDependencies": {
    "electron": "32.1.2",
    "electron-builder": "25.1.4"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  }
}
